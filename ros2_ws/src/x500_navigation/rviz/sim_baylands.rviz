# RViz2 layout: x500 Baylands simulation (SLAM + Nav2, outdoor scale)
# Default view is a 3D chase camera on the drone; "Top-down" and "Map overview"
# are saved in the Views panel.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map & Costmaps1
        - /Sensors1
        - /Navigation1
      Splitter Ratio: 0.55
    Tree Height: 520
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    # ---------------------------------------------------------------- GRIDS
    - Alpha: 0.12
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 90; 140; 200
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid (5 m)
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Alpha: 0.35
      Cell Size: 25
      Class: rviz_default_plugins/Grid
      Color: 90; 160; 230
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid (25 m)
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 8
      Reference Frame: map
      Value: true

    # ------------------------------------------------------ MAP & COSTMAPS
    - Class: rviz_common/Group
      Name: Map & Costmaps
      Enabled: true
      Displays:
        - Alpha: 0.9
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: true
          Enabled: true
          Name: SLAM map
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /map
          Use Timestamp: false
          Value: true
        - Alpha: 0.25
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Global costmap
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap
          Use Timestamp: false
          Value: true
        - Alpha: 0.55
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Local costmap
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap
          Use Timestamp: false
          Value: true

    # -------------------------------------------------------------- SENSORS
    - Class: rviz_common/Group
      Name: Sensors
      Enabled: true
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/LaserScan
          Color: 255; 45; 120
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Lidar /scan
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.1
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /scan
          Use Fixed Frame: true
          Value: true

    # ----------------------------------------------------------- NAVIGATION
    - Class: rviz_common/Group
      Name: Navigation
      Enabled: true
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 255; 140
          Enabled: true
          Line Style: Billboards
          Line Width: 0.15
          Name: Global plan
          Offset: {X: 0, Y: 0, Z: 0.03}
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /plan
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 200; 255
          Enabled: true
          Line Style: Billboards
          Line Width: 0.1
          Name: Local plan
          Offset: {X: 0, Y: 0, Z: 0.05}
          Pose Style: None
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_plan
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 255; 200; 0
          Enabled: true
          Name: Drone footprint
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/published_footprint
          Value: true
        - Alpha: 1
          Axes Length: 0.5
          Axes Radius: 0.05
          Class: rviz_default_plugins/Pose
          Color: 190; 90; 255
          Enabled: true
          Head Length: 0.3
          Head Radius: 0.15
          Name: Goal
          Shaft Length: 0.6
          Shaft Radius: 0.06
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /goal_pose
          Value: true

    # ---------------------------------------------------------------- DRONE
    - Class: rviz_common/Group
      Name: Drone
      Enabled: true
      Displays:
        - Angle Tolerance: 3.14
          Class: rviz_default_plugins/Odometry
          Covariance:
            Value: false
          Enabled: true
          Keep: 400
          Name: Breadcrumb trail
          Position Tolerance: 0.5
          Shape:
            Alpha: 0.9
            Color: 255; 150; 40
            Head Length: 0.12
            Head Radius: 0.12
            Shaft Length: 0.001
            Shaft Radius: 0.001
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odom
          Value: true
        - Angle Tolerance: 0.05
          Class: rviz_default_plugins/Odometry
          Covariance:
            Value: false
          Enabled: true
          Keep: 1
          Name: Heading
          Position Tolerance: 0.02
          Shape:
            Alpha: 1
            Color: 255; 90; 0
            Head Length: 0.5
            Head Radius: 0.3
            Shaft Length: 0.9
            Shaft Radius: 0.12
            Value: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odom
          Value: true
        - Class: rviz_default_plugins/TF
          Enabled: true
          Frame Timeout: 5
          Frames:
            All Enabled: true
          Marker Scale: 1.2
          Name: TF
          Show Arrows: false
          Show Axes: true
          Show Names: true
          Update Interval: 0
          Value: true

  Enabled: true
  Global Options:
    Background Color: 14; 17; 24
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 255; 200; 0
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point: {X: 0, Y: 0, Z: 0}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Chase 3D (follows drone)
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 3.6
    Saved:
      - Angle: 0
        Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Top-down (follows drone)
        Near Clip Distance: 0.01
        Scale: 20
        Target Frame: base_footprint
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0
        Y: 0
      - Angle: 0
        Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Invert Z Axis: false
        Name: Map overview
        Near Clip Distance: 0.01
        Scale: 6
        Target Frame: map
        Value: TopDownOrtho (rviz_default_plugins)
        X: 0
        Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 950
  Hide Left Dock: false
  Hide Right Dock: false
  Navigation 2:
    collapsed: false
  Tool Properties:
    collapsed: true
  Views:
    collapsed: false
  Width: 1600
  X: 60
  Y: 40
