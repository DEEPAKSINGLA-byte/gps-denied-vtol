%% hxstyle.sty - journal-article layout modelled on the HardwareX typeset style:
%% grey header band, left-aligned title, ARTICLE INFO / ABSTRACT block, Charter text,
%% bold "Fig." captions, blue links, running heads. Publisher logos, masthead text, DOI
%% and copyright lines are intentionally NOT reproduced (this is a preprint).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hxstyle}[2026/11/25 HardwareX-like article layout]

%% ---------- page and fonts -------------------------------------------------------
\RequirePackage[a4paper,left=19mm,right=19mm,top=25mm,bottom=24mm,
                headsep=7mm,footskip=11mm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}            % maths, monospace
\RequirePackage{charter}            % body text: Bitstream Charter (Charis-like)
\RequirePackage[scaled=0.90]{helvet}% sans serif for the header band
\RequirePackage[letterspace=300]{microtype}
\RequirePackage{xcolor}
\definecolor{hxlink}{HTML}{0C7DBB}
\definecolor{hxband}{HTML}{E6E6E6}
\definecolor{hxemblem}{HTML}{257DE0}
\setlength{\parindent}{1.4em}
\setlength{\parskip}{0pt}

%% ---------- headings ------------------------------------------------------------
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\normalsize\bfseries}{\thesection.}{0.45em}{}
\titlespacing*{\section}{0pt}{3.2ex plus .6ex minus .2ex}{1.6ex plus .2ex}
\titleformat{\subsection}{\normalfont\normalsize\itshape}{\thesubsection.}{0.45em}{}
\titlespacing*{\subsection}{0pt}{2.2ex plus .4ex minus .2ex}{1.0ex plus .2ex}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection.}{0.45em}{}
\titlespacing*{\subsubsection}{0pt}{1.8ex plus .4ex}{0.8ex}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\itshape}{}{0pt}{}[.]
\titlespacing*{\paragraph}{0pt}{1.0ex plus .3ex}{0.5em}

%% ---------- captions ------------------------------------------------------------
\RequirePackage{caption}
\captionsetup{font=footnotesize,labelfont=bf,labelsep=period,justification=justified,
              singlelinecheck=true,skip=6pt}
\captionsetup[figure]{name=Fig.}
\captionsetup[table]{labelsep=newline,justification=centering,position=top}

%% ---------- links and citations -------------------------------------------------
\RequirePackage[numbers,sort&compress,square]{natbib}
\renewcommand{\bibfont}{\footnotesize}
\setlength{\bibsep}{1.5pt plus 0.5pt}
\PassOptionsToPackage{hyphens}{url}
\RequirePackage[colorlinks=true,linkcolor=hxlink,citecolor=hxlink,urlcolor=hxlink,
                pdfborder={0 0 0}]{hyperref}
\RequirePackage[capitalise,nameinlink]{cleveref}
\crefname{figure}{Fig.}{Figs.}
\Crefname{figure}{Fig.}{Figs.}
\crefname{equation}{Eq.}{Eqs.}
\Crefname{equation}{Eq.}{Eqs.}

%% ---------- running heads -------------------------------------------------------
\RequirePackage{fancyhdr}
\newcommand*{\hx@shortauthors}{}
\newcommand*{\hx@shorttitle}{}
\newcommand*{\hx@topline}{}
\newcommand{\hxshortauthors}[1]{\renewcommand*{\hx@shortauthors}{#1}}
\newcommand{\hxshorttitle}[1]{\renewcommand*{\hx@shorttitle}{#1}}
\newcommand{\hxtopline}[1]{\renewcommand*{\hx@topline}{#1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\itshape\hx@shortauthors}
\fancyhead[R]{\footnotesize\itshape\hx@shorttitle}
\fancyfoot[C]{\footnotesize\thepage}
\renewcommand{\headrulewidth}{0pt}
\fancypagestyle{hxfirst}{%
  \fancyhf{}%
  \fancyhead[C]{\footnotesize\color{hxlink}\hx@topline}%
  \fancyfoot[C]{\footnotesize\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

%% ---------- title block ---------------------------------------------------------
\newcommand*{\hx@bandtop}{}
\newcommand*{\hx@bandtitle}{}
\newcommand*{\hx@bandbottom}{}
\newcommand*{\hx@title}{}
\newcommand*{\hx@authors}{}
\newcommand*{\hx@affils}{}
\newcommand{\hx@info}{}
\newcommand{\hx@abstract}{}
\def\hx@corresp{}
\newcommand{\hxband}[3]{\renewcommand*{\hx@bandtop}{#1}%
  \renewcommand*{\hx@bandtitle}{#2}\renewcommand*{\hx@bandbottom}{#3}}
\renewcommand{\title}[1]{\renewcommand*{\hx@title}{#1}}
\renewcommand{\author}[1]{\renewcommand*{\hx@authors}{#1}}
\newcommand{\affiliations}[1]{\renewcommand*{\hx@affils}{#1}}
\newcommand{\articleinfo}[1]{\renewcommand{\hx@info}{#1}}
\newcommand{\abstracttext}[1]{\renewcommand{\hx@abstract}{#1}}
\newcommand{\correspondence}[1]{\def\hx@corresp{#1}}
\newcommand{\infosep}{\par\vspace{2.2mm}\hrule height 0.3pt\vspace{2.2mm}}

% small quadcopter emblem drawn with TikZ (project artwork, not a journal cover)
\newcommand{\hx@emblem}{%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \fill[hxemblem, rounded corners=3mm] (0,0) rectangle (25,25);
    \draw[white, line width=1.6pt] (6.5,6.5) -- (18.5,18.5) (6.5,18.5) -- (18.5,6.5);
    \foreach \p in {(6.5,6.5),(18.5,18.5),(6.5,18.5),(18.5,6.5)}
      \draw[white, line width=1.1pt] \p circle (3.4);
    \fill[white, rounded corners=0.6mm] (10.3,10.3) rectangle (14.7,14.7);
  \end{tikzpicture}}

\newcommand{\hxmaketitle}{%
  \thispagestyle{hxfirst}%
  \begingroup\setlength{\parindent}{0pt}%
  \begin{minipage}[c]{0.15\textwidth}\raggedright\vspace{4mm}%
    \includegraphics[width=\linewidth]{iit_mandi_logo.pdf}\end{minipage}\hfill
  \begin{minipage}[c]{0.69\textwidth}
    \rule{\linewidth}{0.4pt}\par\vspace{1.2mm}%
    \colorbox{hxband}{\parbox[c][25mm][c]{\dimexpr\linewidth-2\fboxsep\relax}{\centering
      {\sffamily\footnotesize\hx@bandtop\par}\vspace{2.2mm}%
      {\fontsize{17}{20}\selectfont\hx@bandtitle\par}\vspace{2.6mm}%
      {\sffamily\scriptsize\textls[120]{\hx@bandbottom}\par}}}%
  \end{minipage}\hfill
  \begin{minipage}[c]{0.13\textwidth}\raggedleft\vspace{4mm}\hx@emblem\end{minipage}\par
  \vspace{1.6mm}\rule{\textwidth}{2.4pt}\par\vspace{8mm}%
  {\raggedright\fontsize{16.5}{21}\selectfont\hx@title\par}\vspace{3.5mm}%
  {\raggedright\large\hx@authors\par}\vspace{2.2mm}%
  {\raggedright\scriptsize\itshape\hx@affils\par}\vspace{4.5mm}%
  \rule{\textwidth}{0.4pt}\par\vspace{3.5mm}%
  \begin{minipage}[t]{0.29\textwidth}
    {\scriptsize\textls[400]{ARTICLE\ \ INFO}}\par\vspace{1.4mm}\hrule height 0.3pt\vspace{2.2mm}%
    {\scriptsize\raggedright\hx@info\par}%
  \end{minipage}\hfill
  \begin{minipage}[t]{0.665\textwidth}
    {\scriptsize\textls[400]{ABSTRACT}}\par\vspace{1.4mm}\hrule height 0.3pt\vspace{2.2mm}%
    {\footnotesize\hx@abstract\par}%
  \end{minipage}\par\vspace{4mm}%
  \rule{\textwidth}{0.4pt}\par\vspace{5mm}%
  \endgroup
  \ifx\hx@corresp\@empty\else
    \begingroup\renewcommand{\thefootnote}{}%
    \footnotetext{\hspace*{-1.6em}\hx@corresp}\endgroup
  \fi}

\endinput
